# ==========================================
# Nupat Cloud Frontend - Environment Template
# ==========================================

# Backend API URL (Note: NEXT_PUBLIC_* variables are baked at build time in Next.js)
# Local: http://localhost:5000/api (or https://nupat-cloud-backend-dev.vercel.app/api)
# Dev Vercel Project: https://nupat-cloud-backend-dev.vercel.app/api
# Prod Vercel Project: https://nupat-cloud-backend.vercel.app/api
NEXT_PUBLIC_API_URL=https://cloud-backend-dev.vercel.app/api

# Documentation URL
NEXT_PUBLIC_DOCS_URL=https://docs.nupatcloud.com
